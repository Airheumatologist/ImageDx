# Visual Findings Library — environment template
# Copy to .env and fill in secrets. Loaded by src/visual_pilot/config.py.

# -----------------------------------------------------------------------------
# Required provider keys
# -----------------------------------------------------------------------------
# Article discovery uses the public Europe PMC REST API and the PMC open-data
# S3 bucket; neither needs a key. OpenRouter runs the LLM stages (P2-P5).
OPENROUTER_API_KEY=<set-openrouter-api-key>

# -----------------------------------------------------------------------------
# Provider endpoints / models
# -----------------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Pipeline settings (VP_*)
# -----------------------------------------------------------------------------
# Disease catalog: topics (every topic in data/main_database_topics.json, the
# default) or pilot (the ten curated pilot diseases only).
VP_CATALOG=topics
# LLM provider (OpenRouter is the only one supported).
VP_LLM_PROVIDER=openrouter
VP_TRIAGE_MODEL=stealth/space-bunny-alpha
VP_EXTRACT_MODEL=stealth/space-bunny-alpha
VP_JUDGE_MODEL=stealth/space-bunny-alpha
# Display captions/sections (P5); defaults to VP_EXTRACT_MODEL.
VP_DESCRIBE_MODEL=stealth/space-bunny-alpha
# Topic findings vocabulary (build-vocab, P6); defaults to VP_EXTRACT_MODEL.
VP_VOCAB_MODEL=stealth/space-bunny-alpha
# Per-stage reasoning effort (minimal|low|medium|high; empty = model default, which
# reasons at length: ~5k output tokens per vision call, ~17k per 40-caption
# triage batch). A set effort is part of the llm_calls cache key.
VP_TRIAGE_REASONING_EFFORT=minimal
VP_JUDGE_REASONING_EFFORT=minimal
VP_DESCRIBE_REASONING_EFFORT=
VP_EXTRACT_REASONING_EFFORT=
VP_VOCAB_REASONING_EFFORT=medium
# Optional: JSON merge into the per-model $/1M price table, e.g.
# '{"stealth/space-bunny-alpha": {"in": 0.0, "out": 0.0}}'
VP_MODEL_PRICES_JSON=
VP_IMAGE_MAX_EDGE=1568
# Max in-flight LLM calls for triage, describe and extract.
VP_CONCURRENCY=16
VP_LLM_TIMEOUT_SECONDS=300
# Figures per triage call; smaller batches return sooner and fill more slots.
VP_TRIAGE_BATCH=20
# Per-pair gallery coverage band; discovery searches pairs below TARGET. FLOOR is the
# minimum distinct published images a (disease, finding) lane must retain,
# TARGET is the coverage goal, and GALLERY_CAP is the global per-pair gallery
# cap on published images only; eligible surplus stays stored as uncapped
# reserves. Must satisfy
# 1 <= VP_FINDING_IMAGE_FLOOR <= VP_FINDING_IMAGE_TARGET <= VP_FINDING_GALLERY_CAP;
# invalid or non-integer values abort startup with a clear error.
VP_FINDING_IMAGE_FLOOR=3
VP_FINDING_IMAGE_TARGET=10
VP_FINDING_GALLERY_CAP=20
VP_DATA_DIR=data/visual_pilot
# Optional: raises NCBI rate limit from 3 to 10 req/s
VP_NCBI_API_KEY=

# -----------------------------------------------------------------------------
# Throughput settings: request rates, worker pools, timeouts and caches.
# -----------------------------------------------------------------------------
# Request rate for the public S3 bucket (pmc-oa-opendata); NCBI hosts unchanged.
VP_S3_RPS=20
# Worker pool size for discovery fetch/parse and store stages.
VP_FETCH_CONCURRENCY=16
# Europe PMC searches run ahead of ingestion on this many workers, capped at
# VP_EPMC_RPS requests/second; searches lost to outages are retried once
# after VP_SEARCH_RETRY_COOLDOWN seconds at the end of each pass.
VP_SEARCH_CONCURRENCY=8
VP_EPMC_RPS=8
VP_SEARCH_RETRY_COOLDOWN=60
# Max in-flight P3 vision-judge LLM calls. 429s back off and retry
# (VP_RATE_LIMIT_RETRIES); lower this if the timings report shows many.
VP_JUDGE_CONCURRENCY=16
# Per-request LLM timeout (seconds) for the P3 judge.
VP_JUDGE_TIMEOUT_SECONDS=120
# Retries on HTTP 429 provider responses (independent of max_retries).
VP_RATE_LIMIT_RETRIES=4
# In-memory cap (MB) for the judge->store original-bytes handoff cache.
VP_ORIGINALS_CACHE_MB=512
# Timing instrumentation: 1 writes reports/timings_<utc>.json during run-all
# (rewritten after every batch).
VP_TIMINGS=1
# Parity harness: 1 makes an llm_calls cache miss raise instead of calling the
# provider. Only set for seeded, cache-only reruns.
VP_LLM_CACHE_ONLY=0

