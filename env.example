# Visual Findings Library — environment template
# Copy to .env and fill in secrets. Loaded by src/visual_pilot/config.py.

# -----------------------------------------------------------------------------
# Required provider keys
# -----------------------------------------------------------------------------
# Discovery uses public Europe PMC and PMC S3; neither needs a key.
# Text stages: OpenCode Go Iceman. OPENCODE_API_KEY is an accepted alias.
OPENCODE_GO_API_KEY=<paste-opencode-go-key>
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Vision stage: OpenRouter GLM, strictly limited to OpenInference in code.
OPENROUTER_API_KEY=<paste-openrouter-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Pipeline settings (VP_*)
# -----------------------------------------------------------------------------
VP_TRIAGE_MODEL=opencode-go/iceman-contributor-free
VP_EXTRACT_MODEL=opencode-go/iceman-contributor-free
VP_JUDGE_MODEL=z-ai/glm-5.3-flash
VP_DESCRIBE_MODEL=opencode-go/iceman-contributor-free
VP_VOCAB_MODEL=opencode-go/iceman-contributor-free
# Iceman uses default reasoning; GLM uses OpenRouter's low effort.
VP_TRIAGE_REASONING_EFFORT=
VP_JUDGE_REASONING_EFFORT=low
VP_DESCRIBE_REASONING_EFFORT=
VP_EXTRACT_REASONING_EFFORT=
VP_VOCAB_REASONING_EFFORT=
# Optional: JSON merge into the per-model $/1M price table, e.g.
# '{"some-model": {"in": 0.10, "cached_in": 0.02, "out": 0.30}}'
VP_MODEL_PRICES_JSON=
VP_IMAGE_MAX_EDGE=1568
# Before triage/judge, skip images already published for every attributed
# topic in this exported site. Defaults to the repository's site/ directory.
# VP_PUBLISHED_SITE_DIR=/absolute/path/to/site
# Max in-flight LLM calls for triage, describe and extract.
VP_CONCURRENCY=64
# Max in-flight LLM calls across all stages combined.
VP_LLM_MAX_IN_FLIGHT=128
# LLM requests per minute across all stages, spaced evenly (0 = unpaced). Set
# it to a provider's per-minute limit so requests wait instead of failing.
VP_LLM_RPM=0
# Output-token cap per LLM request, reasoning included (0 = provider default).
# Valid replies stay under ~8k; the cap stops rare runaway generations.
VP_LLM_MAX_OUTPUT_TOKENS=16384
# Per-read timeout. Calls stream, so a healthy request never goes quiet for
# more than a few seconds; this mostly bounds gateway stalls.
VP_LLM_TIMEOUT_SECONDS=90
# Wall-clock cap per LLM request (the timeout above is per read).
VP_LLM_MAX_REQUEST_SECONDS=600
# Figures per triage call; smaller batches return sooner and fill more slots.
VP_TRIAGE_BATCH=20
# Per-pair gallery coverage band; discovery searches pairs below TARGET. FLOOR is the
# minimum distinct published images a (disease, finding) lane must retain,
# TARGET is the coverage goal, and GALLERY_CAP is the global per-pair gallery
# cap on published images only; eligible surplus stays stored as uncapped
# reserves. Must satisfy
# 1 <= VP_FINDING_IMAGE_FLOOR <= VP_FINDING_IMAGE_TARGET <= VP_FINDING_GALLERY_CAP;
# invalid or non-integer values abort startup with a clear error.
VP_FINDING_IMAGE_FLOOR=3
VP_FINDING_IMAGE_TARGET=10
VP_FINDING_GALLERY_CAP=20
# Topics with fewer distinct published images than this also get the
# disease-wide discovery pass (case reports naming the disease in the title or
# abstract, then any article titled with it; no caption phrase).
VP_TOPIC_IMAGE_FLOOR=10
# Topics showing fewer distinct images than this top up with unlabeled images
# (publishable except that the source never names the finding); 0 disables.
VP_UNLABELED_FILL_TARGET=20
# Most distinct images a topic's default view shows (pair galleries
# round-robin, then combined plates, then the fill); 0 disables.
VP_TOPIC_IMAGE_CAP=0
# Articles fetched per thin topic per disease-pass round (a sweep of the tail
# before depth on one topic).
VP_TOPIC_ARTICLES_PER_ROUND=50
# Publish whole-figure single-disease collages with no approved finding as
# unlabeled fill (uncropped, no pair credit); 0 keeps them dropped.
VP_ALLOW_UNLABELED_PLATES=0
# Second-tier thin-topic search without the Europe PMC LICENSE clause; the
# local JATS/figure license gate still decides, so NC never publishes.
VP_RELAXED_LICENSE_SEARCH=0
VP_DATA_DIR=data/visual_pilot
# Optional: raises NCBI rate limit from 3 to 10 req/s
VP_NCBI_API_KEY=

# -----------------------------------------------------------------------------
# Throughput settings: request rates, worker pools, timeouts and caches.
# -----------------------------------------------------------------------------
# Request rate for the public S3 bucket (pmc-oa-opendata); NCBI hosts unchanged.
# The bucket is AWS Open Data. A fetch takes ~0.3-0.75 s from a home
# connection, so VP_FETCH_CONCURRENCY workers, not this cap, usually set the pace.
VP_S3_RPS=150
# Worker pool size for discovery fetch/parse, judge image fetches and store.
VP_FETCH_CONCURRENCY=64
# Europe PMC searches run ahead of ingestion on this many workers, capped at
# VP_EPMC_RPS requests/second; searches lost to outages are retried once
# after VP_SEARCH_RETRY_COOLDOWN seconds at the end of each pass.
VP_SEARCH_CONCURRENCY=8
VP_EPMC_RPS=8
VP_SEARCH_RETRY_COOLDOWN=60
# Max in-flight P3 vision-judge LLM calls. 429s back off and retry
# (VP_RATE_LIMIT_RETRIES); lower this if the timings report shows many.
VP_JUDGE_CONCURRENCY=64
# Per-request LLM timeout (seconds) for the P3 judge.
VP_JUDGE_TIMEOUT_SECONDS=90
# Retries on HTTP 429 provider responses (independent of max_retries).
# A 402 (provider credits/quota spent) stops the run instead.
VP_RATE_LIMIT_RETRIES=4
# In-memory cap (MB) for the judge->store original-bytes handoff cache.
VP_ORIGINALS_CACHE_MB=512
# Timing instrumentation: 1 writes reports/timings_<utc>.json during run-all
# (rewritten after every batch).
VP_TIMINGS=1
# Parity harness: 1 makes an llm_calls cache miss raise instead of calling the
# provider. Only set for seeded, cache-only reruns.
VP_LLM_CACHE_ONLY=0

