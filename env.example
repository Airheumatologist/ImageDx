# Visual Findings Library — environment template
# Copy to .env and fill in secrets. Loaded by src/visual_pilot/config.py.

# -----------------------------------------------------------------------------
# Required provider keys
# -----------------------------------------------------------------------------
# turbopuffer hosts the prebuilt PMC chunk index used by stage 2 selection.
TURBOPUFFER_API_KEY=<set-turbopuffer-api-key>
# DeepInfra is used only for embeddings and reranking.
DEEPINFRA_API_KEY=<set-deepinfra-api-key>
# OpenCode Zen or OpenRouter runs LLM stages (P1-P4).
OPENCODE_API_KEY=<set-opencode-api-key>
OPENROUTER_API_KEY=<set-openrouter-api-key>

# -----------------------------------------------------------------------------
# Provider endpoints / models
# -----------------------------------------------------------------------------
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DeepInfra-hosted embedding model (embeddings/reranking only).
RUNTIME_EMBEDDING_MODEL=BAAI/bge-m3

# -----------------------------------------------------------------------------
# turbopuffer PMC namespace (prebuilt; this repo does not ingest source data)
# -----------------------------------------------------------------------------
TURBOPUFFER_REGION=gcp-us-central1
TURBOPUFFER_NAMESPACE_PMC=medical_database_pmc
TURBOPUFFER_TIMEOUT_SECONDS=30
# Selection batches compact projections with multi_query where supported,
# limits search to one row per PMCID, then hydrates shortlist metadata. Query
# byte counters are recorded in reports/stage2_counts.json.

# -----------------------------------------------------------------------------
# Pipeline settings (VP_*)
# -----------------------------------------------------------------------------
# OpenRouter is the primary LLM provider; DeepInfra keys are for embeddings only.
VP_LLM_PROVIDER=openrouter
VP_TRIAGE_MODEL=stealth/space-bunny-alpha
VP_EXTRACT_MODEL=stealth/space-bunny-alpha
VP_JUDGE_MODEL=stealth/space-bunny-alpha
# Optional: JSON merge into the per-model $/1M price table, e.g.
# '{"stealth/space-bunny-alpha": {"in": 0.0, "out": 0.0}}'
VP_MODEL_PRICES_JSON=
VP_IMAGE_MAX_EDGE=1568
# Stage-5 storage encoding: panel format (webp|jpeg|png), lossy quality, and
# max-edge caps for stored panels and the display copy of each original.
# png keeps lossless archival crops at much larger file sizes.
VP_PANEL_FORMAT=webp
VP_PANEL_QUALITY=90
VP_PANEL_MAX_EDGE=2048
VP_ORIGINAL_MAX_EDGE=2048
VP_CONCURRENCY=4
VP_LLM_TIMEOUT_SECONDS=300
VP_TRIAGE_BATCH=40
# Maximum finding/modality searches per disease; 0 means every approved,
# disease-specific finding (the default).
VP_VISUAL_QUERY_CAP=0
# Round-robin per-finding article quota before global RRF fills a finite --limit.
VP_MANIFESTATION_QUOTA=20
# Distinct published images targeted per approved (disease, finding) pair.
VP_FINDING_IMAGE_TARGET=10
# Persisted-candidate caption rescue: rows peeked per batch (0 disables) and
# the confirming captions required for those ex-candidate rescues.
VP_CAPTION_RESCUE_PEEK=50
VP_CAPTION_RESCUE_MIN_CAPTIONS=2
# Extra per-synonym visual queries for under-target findings; 0 disables.
VP_TARGETED_SYNONYM_QUERIES=3
# Europe PMC batched article-license lookups (final source; S3 fallback only):
# PMCIDs per searchPOST call and concurrent batch calls in flight.
VP_EPMC_LICENSE_BATCH=100
VP_EPMC_CONCURRENCY=4
VP_DATA_DIR=data/visual_pilot
# Optional: raises NCBI rate limit from 3 to 10 req/s
VP_NCBI_API_KEY=

# -----------------------------------------------------------------------------
# Throughput-plan keys (docs/visual_pilot_plan.md §4 contract C1).
# Defaults preserve current behavior; later workstreams switch these on.
# -----------------------------------------------------------------------------
# Request rate for the public S3 bucket (pmc-oa-opendata); NCBI hosts unchanged.
VP_S3_RPS=20
# Worker pool size for HTTP fetch/parse/store stages.
VP_FETCH_CONCURRENCY=8
# Max in-flight P3 vision-judge LLM calls (raise only after the W11 probe).
VP_JUDGE_CONCURRENCY=4
# Max in-flight P1 relevance calls (defaults to VP_CONCURRENCY when unset).
VP_P1_CONCURRENCY=4
# Per-request LLM timeout (seconds) for the P3 judge.
VP_JUDGE_TIMEOUT_SECONDS=120
# Retries on HTTP 429 provider responses (independent of max_retries).
VP_RATE_LIMIT_RETRIES=4
# In-memory cap (MB) for the judge->store original-bytes handoff cache.
VP_ORIGINALS_CACHE_MB=512
# Timing instrumentation: 1 writes reports/timings_<utc>.json after run-all.
VP_TIMINGS=1
# Parity harness: 1 makes an llm_calls cache miss raise instead of calling the
# provider. Only set for seeded candidate runs (see parity.py).
VP_LLM_CACHE_ONLY=0
