# Production handoff environment template
# Fill in secrets and deploy.

# -----------------------------------------------------------------------------
# Required provider keys
# -----------------------------------------------------------------------------
OPENCODE_API_KEY=<set-opencode-zen-api-key>
DEEPINFRA_API_KEY=<set-deepinfra-api-key>
TURBOPUFFER_API_KEY=<set-turbopuffer-api-key>

# -----------------------------------------------------------------------------
# Runtime providers (fixed for production handoff)
# -----------------------------------------------------------------------------
VECTOR_BACKEND=turbopuffer
RETRIEVAL_BACKEND=turbopuffer
LLM_PROVIDER=opencode
LLM_MODEL=space-bunny-free
QUERY_PREPROCESSOR_LLM_MODEL=space-bunny-free
EMBEDDING_PROVIDER=deepinfra
RUNTIME_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_PROVIDER=deepinfra
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# -----------------------------------------------------------------------------
# Turbopuffer runtime namespaces
# -----------------------------------------------------------------------------
TURBOPUFFER_REGION=gcp-us-central1
TURBOPUFFER_NAMESPACE_PMC=medical_database_pmc
TURBOPUFFER_NAMESPACE_PUBMED=medical_database_pubmed
TURBOPUFFER_NAMESPACE_DAILYMED=medical_database_dailymed
TURBOPUFFER_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# API runtime
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_MAX_INFLIGHT_REQUESTS=256
API_INFLIGHT_ACQUIRE_TIMEOUT_MS=250
API_EXECUTOR_MAX_WORKERS=64
API_SHUTDOWN_GRACE_SECONDS=85
API_INFLIGHT_DRAIN_POLL_SECONDS=0.2
UPSTREAM_HTTP_MAX_CONNECTIONS=200
UPSTREAM_HTTP_MAX_KEEPALIVE=100
UPSTREAM_HTTP_KEEPALIVE_EXPIRY=30

# -----------------------------------------------------------------------------
# Gunicorn/Uvicorn runtime tuning (container deploy)
# -----------------------------------------------------------------------------
WEB_CONCURRENCY=4
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=90
GUNICORN_KEEPALIVE=5
GUNICORN_BACKLOG=2048
GUNICORN_LOG_LEVEL=info
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker

# Uvicorn standalone knobs (used when running uvicorn directly)
UVICORN_LOOP=auto
UVICORN_HTTP=auto
UVICORN_LIMIT_CONCURRENCY=128
UVICORN_BACKLOG=2048

# -----------------------------------------------------------------------------
# Retrieval + ranking profile
# -----------------------------------------------------------------------------
USE_HYBRID_SEARCH=true
RETRIEVAL_RRF_K=60
RETRIEVAL_DENSE_WEIGHT=0.7
RETRIEVAL_SPARSE_WEIGHT=0.3
TURBOPUFFER_INCLUDE_ALL_ATTRIBUTES=false

CHUNK_SIZE_TOKENS=2048
CHUNK_OVERLAP_TOKENS=256
RETRIEVAL_CHUNK_LIMIT=200
RETRIEVAL_FUSED_LIMIT=250
MAX_CHUNKS_PER_ARTICLE_PRE_RERANK=2
RERANK_INPUT_CHUNK_LIMIT=100
RERANK_EVAL_LIMIT=-1
RERANK_KEEP_LIMIT=75
RETRIEVAL_QUERY_FANOUT_LIMIT=250
RERANK_COUNTRY_BOOST_ENABLED=true
RERANK_COUNTRY_BOOST_MULTIPLIER=1.05
RERANK_COUNTRY_BOOST_POLICY=us_eu27
PMC_PUBMED_MIN_FINAL_ARTICLES=8
PMC_PUBMED_ARTICLE_RELEVANCE_THRESHOLD=0.5
FINAL_TOP_ARTICLES=35
DAILYMED_MAX_RETRIEVAL_RESULTS=15
DAILYMED_MAX_FINAL_REFERENCES=15

FINAL_RECENCY_POLICY_MODE=hybrid
FINAL_RECENCY_WINDOW_YEARS=5
PRE_RERANK_RECENT_WINDOW_YEARS=7
PRE_RERANK_RECENT_QUOTA_RATIO=0.35

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
QUERY_CACHE_ENABLED=true
QUERY_CACHE_DIR=data/cache
QUERY_CACHE_EXPIRY_DAYS=30
QUERY_CACHE_NAMESPACE=default
QUERY_CACHE_KEY_VERSION=2

# -----------------------------------------------------------------------------
# Optional endpoint/timeouts overrides
# -----------------------------------------------------------------------------
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_CHAT_TIMEOUT_SECONDS=300

DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_CHAT_TIMEOUT_SECONDS=300
DEEPINFRA_EMBED_TIMEOUT_SECONDS=120
DEEPINFRA_RERANK_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Visual findings pilot (src/visual_pilot) — no secrets here; keys come from
# XAI_API_KEY / DEEPINFRA_API_KEY / TURBOPUFFER_API_KEY above.
# -----------------------------------------------------------------------------
# deepinfra is the default; "opencode" and "xai" also resolve if src.config
# or the environment provides their creds.
VP_LLM_PROVIDER=deepinfra
VP_TRIAGE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
VP_EXTRACT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
VP_JUDGE_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct
# Optional: JSON merge into the per-model $/1M price table, e.g.
# '{"Qwen/Qwen3-VL-235B-A22B-Instruct": {"in": 0.20, "out": 0.88}}'
VP_MODEL_PRICES_JSON=
VP_IMAGE_MAX_EDGE=1568
VP_CONCURRENCY=4
VP_DATA_DIR=data/visual_pilot
# Optional: raises NCBI rate limit from 3 to 10 req/s
VP_NCBI_API_KEY=
